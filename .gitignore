# ---- Python / tooling noise -------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
build/
dist/

# ---- Large, regenerable artefacts (kept out of git by policy) --------------
# Model checkpoints: the historical EXP-001 baseline is already committed as
# evidence; new training runs are reproducible from the scripts + configs and
# are published as release artefacts instead.
# (EXP-001 stays committed as historical evidence; every later run is
# reproducible from scripts/configs and republished via release/.)
checkpoints/EXP-002/
checkpoints/EXP-002-*/
checkpoints/EXP-003/
checkpoints/EXP-003-*/
checkpoints/EXP-004/
checkpoints/EXP-004-*/
checkpoints/EXP-005/
checkpoints/EXP-005-*/
# Curriculum pilots follow the same policy: weights are reproducible from the
# scripts + configs and are published via release/ if selected.
checkpoints/CURRIC-*/
checkpoints/_test_np/
# Packed token shards (rebuild with scripts/prepare_data_v2.py)
datasets/processed/*/shards/
# CI/unit-test fixture datasets built on demand by tests/conftest.py
datasets/versions/ci_*/
datasets/processed/ci_*/
# Sandbox scratch space
/var/tmp/tinyme-sandbox/

# ---- Session-audit runs (2026-10-03) ---------------------------------------
# Weights and packed corpora of the v7/v8 retraining lineage are regenerable
# from the committed scripts + manifests (the manifests carry the dataset
# fingerprint and per-file sha256, and docs/VERIFICATION_MATRIX.md records the
# exact rebuild command).  Committing them would add ~150 MB of binaries to the
# repository for data that a documented rebuild reproduces.
checkpoints/EXP-00[6-9]*/
checkpoints/EXP-01[0-9]*/
datasets/versions/dataset_v7/train.jsonl
datasets/versions/dataset_v7/validation.jsonl
datasets/versions/dataset_v7/test.jsonl
datasets/versions/dataset_v7/challenge.jsonl
datasets/versions/dataset_v8/train.jsonl
datasets/versions/dataset_v8/validation.jsonl
datasets/versions/dataset_v8/test.jsonl
datasets/versions/dataset_v8/challenge.jsonl
